# Terraform local state and cache
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Real variable values (often contain project-specific or sensitive data)
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc
